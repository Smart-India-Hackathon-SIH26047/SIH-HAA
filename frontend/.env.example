# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: set to 1 to call the API through Vite's /api proxy (same-origin).
VITE_DEV_PROXY=

# Until there is a real session/auth flow, identities come from env.
# Both MUST be UUIDs from the backend seed scripts:
#   person  -> python backend/seed_synthetic_cases.py
#   officer -> python backend/seed_officers.py   (prints role, district, id)
VITE_DEMO_PERSON_ID=
VITE_DEMO_OFFICER_ID=

# Supabase, used for authentication only (Project Settings > API).
# The anon/publishable key is safe in a browser bundle; RLS protects the data.
# Never put the service_role key here. See docs/auth-setup.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
