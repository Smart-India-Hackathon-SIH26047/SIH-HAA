# Copy to backend/.env and fill in. .env is gitignored; .env.example is not,
# so never put a real key or password in this file.

# --- Required ------------------------------------------------------------

# Postgres connection string. Postgres specifically: the models use the
# postgresql UUID column type, so SQLite will not work without changes.
#   local docker : postgresql+psycopg2://postgres:PASSWORD@127.0.0.1:5432/saathi
#   supabase     : postgresql+psycopg2://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# Google AI Studio key for the chatbot (https://aistudio.google.com/apikey).
# Read at import time in app/chatbot.py, so the app will not start without it.
GEMINI_API_KEY=

# --- Optional: score-gated support offer ---------------------------------

# Shown when someone enters the elevated/priority band. The call number
# defaults to the Tele-MANAS line that the system prompt mandates.
# SUPPORT_CALL_NUMBER=1860-445-4435
# SUPPORT_CALL_NAME=Tele-MANAS

# No default on purpose. The SMS option is omitted from the offer entirely
# until this is set, so that no unmonitored number is ever shown to someone
# in distress. Set it only to a real, staffed number.
# SUPPORT_SMS_NUMBER=

# How long to stay quiet after offering support, in hours (default 12).
# SUPPORT_OFFER_COOLDOWN_HOURS=12
